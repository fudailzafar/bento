# Where the app is hosted (defaults to https://bentoprofile.vercel.app)
NEXT_PUBLIC_SITE_URL=

# PostgreSQL (Neon). DATABASE_URL is the pooled connection the app uses;
# DIRECT_URL is the direct one Prisma uses for migrations.
DATABASE_URL=
DIRECT_URL=
# Connections each server instance may open (default 5)
DATABASE_POOL_MAX=

# Better Auth. The secret must be at least 16 characters, e.g. `openssl rand -hex 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Optional: sign in with Google (set both or neither)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 storage for uploaded pictures and videos
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bento-me
NEXT_PUBLIC_R2_PUBLIC_URL=

# Secret for the daily media cleanup (Vercel Cron sends it as a bearer token)
CRON_SECRET=
