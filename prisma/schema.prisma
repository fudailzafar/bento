generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  username  String?  @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  page      Page?
}

model Page {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String?
  headline  String?
  bio       String?
  website   String?
  email     String?
  twitter   String?
  linkedin  String?
  github    String?
  blocks    Block[]
  views     PageView[]
  clicks    BlockClick[]
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum BlockType {
  LINK
  IMAGE
  TEXT
  MAP
  SECTION_TITLE
}

model Block {
  id        String    @id @default(uuid())
  pageId    String
  type      BlockType
  x         Int
  y         Int
  w         Int
  h         Int
  // The phone layout's own position and size; null until it is set.
  mx        Int?
  my        Int?
  mw        Int?
  mh        Int?
  data      Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model PageView {
  id        String   @id @default(uuid())
  pageId    String
  createdAt DateTime @default(now())
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
}

model BlockClick {
  id        String   @id @default(uuid())
  pageId    String
  blockId   String
  createdAt DateTime @default(now())
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
}
